{
  "schema_version": 1,
  "contract_version": "1.0",
  "xpbuilder_version": "0.1.0",
  "runtime": "standalone",
  "runtime_modes": [
    "standalone",
    "linked"
  ],
  "moodle_integration": false,
  "optional_features": {
    "moodle_integration": {
      "flag": "XPBUILDER_MOODLE_INTEGRATION",
      "default": false,
      "description": "Report Designer 'Sync tables' API plus the 'Sync to Moodle' actions. A single built image serves both modes; off keeps the standalone runtime."
    },
    "ai_provider_settings": {
      "flag": "XP_PROMPT_SERVICE_SECRET",
      "default": true,
      "description": "Settings -> Manage -> AI Provider. Provider API keys are typed in Superset, sealed with Fernet in the XP Prompt database, and used by the XP Prompt AI service; no provider key is read from .env.",
      "page": "/aiprovider/",
      "internal_token_salt": "xp-prompt-internal-admin-v1",
      "api_endpoint": "/ai/providers",
      "proxy": "superset/superset/views/ai_provider/views.py",
      "service": "services/xp_prompt/xp_prompt/api.py",
      "health_migration": "20261103_03",
      "retry_policy": {
        "max_attempts_per_provider": 2,
        "failure_threshold": 3,
        "max_open_seconds": 900
      }
    },
    "ai_prompt_workspace": {
      "flag": "XP_PROMPT_API_URL",
      "default": true,
      "description": "Top-level 'XP Prompt' chat workspace. The browser talks only to the Superset proxy, which injects superset_user_id from the session; conversations and sealed message bodies live in the XP Prompt database.",
      "page": "/aiprompt/",
      "proxy": "superset/superset/views/ai_prompt/views.py",
      "service": "services/xp_prompt/xp_prompt/api.py",
      "store": "services/xp_prompt/xp_prompt/conversations.py",
      "turn": "services/xp_prompt/xp_prompt/chat.py",
      "intent_router": "services/xp_prompt/xp_prompt/intents.py",
      "intents": [
        "query",
        "dataset",
        "chart",
        "dashboard",
        "explanation",
        "modification",
        "clarification"
      ],
      "permission_script": "docker/ensure_ai_prompt_permissions.py",
      "context_migration": "20261103_04",
      "jobs_module": "services/xp_prompt/xp_prompt/jobs.py",
      "jobs_migration": "20261103_05",
      "response_blocks_module": "services/xp_prompt/xp_prompt/responses.py",
      "response_blocks_types": "superset/superset-frontend/src/features/aiPrompt/types.ts",
      "response_blocks_renderer": "superset/superset-frontend/src/features/aiPrompt/blocks.tsx",
      "response_blocks": [
        "clarification",
        "plan",
        "assumptions",
        "sql_preview",
        "result_preview",
        "dataset_profile",
        "chart_recommendation",
        "dashboard_proposal",
        "warnings",
        "repair",
        "links"
      ],
      "job_types": [
        "ping"
      ],
      "job_statuses": [
        "queued",
        "running",
        "clarification",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "roles": [
        "Admin",
        "Alpha",
        "Gamma"
      ],
      "max_message_chars": 8000,
      "max_history_messages": 20
    }
  },
  "superset": {
    "version": "6.1.0",
    "build": "source",
    "source": "https://github.com/apache/superset",
    "source_tag": "6.1.0",
    "source_commit": "c83fb2bb1dcfac41ac51bcebd82471f4a7180d18",
    "vendored_at": "2026-08-26"
  },
  "required_contracts": [
    "security-login",
    "dashboard-crud",
    "chart-crud",
    "dataset-crud",
    "embedded-dashboard-registration",
    "guest-token",
    "health"
  ]
}
