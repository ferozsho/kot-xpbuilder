# Storybook environment variables (local dev only — copy to `.env`; `.env`
# itself is gitignored, never commit real keys here).
#
# Mapbox public token used only by the map-box chart Storybook preview
# (plugins/legacy-plugin-chart-map-box/src/stories/data.ts). The runtime
# chart reads its key from each chart's config in Superset, not from env.
MAPBOX_API_KEY=
